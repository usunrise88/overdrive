# OS / editors
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Secrets and local config. Server secrets live in the server environment only (spec §7.2).
.env
.env.*
!.env.example
local.properties
*.jks
*.keystore
secrets/

# Node / pnpm
node_modules/
dist/
coverage/
*.tsbuildinfo

# Gradle / Kotlin / Android
.gradle/
.kotlin/
build/
captures/
*.apk
*.aab
*.hprof

# Local tool state (agent worktrees live under .claude/worktrees)
.claude/settings.local.json
.claude/worktrees/

# Large runtime data, e.g. the BRouter tiles in data/brouter (docs/deploy.md, section 19)
/data/

# Generated ride artifacts used during manual testing
*.fit
!contracts/fixtures/**/*.fit

# macOS Xcode project (generated via XcodeGen from macos/project.yml) & local signing config
macos/Overdrive.xcodeproj/
macos/Config/LocalSigning.xcconfig
macos/DerivedData/

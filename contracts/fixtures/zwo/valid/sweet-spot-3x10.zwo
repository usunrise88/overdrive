<workout_file>
    <author>Overdrive tests</author>
    <name>Sweet spot 3x10</name>
    <description>Three 10-minute efforts with 5-minute recoveries.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="SWEET_SPOT"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.70"/>
        <IntervalsT Repeat="3" OnDuration="600" OnPower="0.88" OffDuration="300" OffPower="0.50"/>
        <FreeRide Duration="300" FlatRoad="1"/>
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40"/>
    </workout>
</workout_file>

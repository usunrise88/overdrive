{
  "name": "@overdrive/server",
  "version": "0.0.0",
  "private": true,
  "description": "Overdrive web service: sync API, MCP server, scheduler, integrations, bot, insights (spec §7.2).",
  "type": "module",
  "scripts": {
    "dev": "node --conditions=source --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "hash-passphrase": "node src/hash-passphrase.ts",
    "google-auth": "node src/gcal/auth-cli.ts",
    "strava-auth": "node src/strava-auth.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@overdrive/contracts": "workspace:*",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!-- What the app's FileProvider may hand to other apps: the stored rides (ADR 0008) and the raw Bluetooth logs (ADR 0010),
     nothing else under the app's files. -->
<paths>
    <files-path
        name="rides"
        path="rides/" />
    <files-path
        name="ble_logs"
        path="ble-logs/" />
</paths>

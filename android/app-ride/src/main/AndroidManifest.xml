<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The overlay (spec §4.6, ADR 0006). Nothing here touches the network: the ride app works fully offline.
         SYSTEM_ALERT_WINDOW: the "Display over other apps" special access, granted by the rider in system settings.
         FOREGROUND_SERVICE and FOREGROUND_SERVICE_SPECIAL_USE: the service that owns the window and keeps the ride
         alive behind other apps. M3 adds connectedDevice and BLUETOOTH_CONNECT when real Bluetooth arrives.
         POST_NOTIFICATIONS: the service's "Ride in progress" notification is shown on Android 13 and later only if
         the rider allows it; the overlay works either way.
         Rides (ADR 0008) are private app data and need no permission: they are shared through the FileProvider below
         and saved through the system file picker. The app has no network permission, and allowBackup stays false. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OverdriveApp"
        android:allowBackup="false"
        android:label="Overdrive"
        android:theme="@style/Theme.Overdrive">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands one FIT file at a time to the app the rider chose in the share sheet, read-only, through a URI the
             sheet is granted. Not exported: nothing else can ask it for a file. Only filesDir/rides/ is served. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the ride session alive and draws its numbers in a small window over other apps while the rider watches video" />
        </service>
    </application>
</manifest>
